<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 12 (API 31–32): music and videos are read with the older storage permission. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- ReplayGain tags written straight into phone music files, without asking each time (2026-11-21 22:55):
         Android's "All files access", granted once in its settings. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Alarm clock: exact alarms, set again after a restart, ringing screen over the lock screen, vibration,
         optional place check for the wake check. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Alarms shown in the phone's calendar (optional, asked when switched on). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- "Open Shazam" in the radio menu: Android 11+ only shows apps that are named here. -->
    <queries>
        <package android:name="com.shazam.android" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:allowAudioPlaybackCapture="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.VlcInterface"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="video/*" />
                <data android:scheme="file" android:mimeType="video/*" />
                <data android:scheme="content" android:mimeType="audio/*" />
            </intent-filter>
            <!-- SHOUTcast / Icecast: links marked as radio playlists or streams (by type) open in the radio player. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" android:mimeType="audio/x-scpls" />
                <data android:scheme="https" android:mimeType="audio/x-scpls" />
                <data android:scheme="content" android:mimeType="audio/x-scpls" />
                <data android:scheme="file" android:mimeType="audio/x-scpls" />
                <data android:scheme="http" android:mimeType="audio/scpls" />
                <data android:scheme="https" android:mimeType="audio/scpls" />
                <data android:scheme="content" android:mimeType="audio/scpls" />
                <data android:scheme="file" android:mimeType="audio/scpls" />
                <data android:scheme="http" android:mimeType="application/pls+xml" />
                <data android:scheme="https" android:mimeType="application/pls+xml" />
                <data android:scheme="content" android:mimeType="application/pls+xml" />
                <data android:scheme="file" android:mimeType="application/pls+xml" />
                <data android:scheme="http" android:mimeType="audio/x-mpegurl" />
                <data android:scheme="https" android:mimeType="audio/x-mpegurl" />
                <data android:scheme="content" android:mimeType="audio/x-mpegurl" />
                <data android:scheme="file" android:mimeType="audio/x-mpegurl" />
                <data android:scheme="http" android:mimeType="audio/mpegurl" />
                <data android:scheme="https" android:mimeType="audio/mpegurl" />
                <data android:scheme="content" android:mimeType="audio/mpegurl" />
                <data android:scheme="file" android:mimeType="audio/mpegurl" />
                <data android:scheme="http" android:mimeType="application/x-mpegurl" />
                <data android:scheme="https" android:mimeType="application/x-mpegurl" />
                <data android:scheme="content" android:mimeType="application/x-mpegurl" />
                <data android:scheme="file" android:mimeType="application/x-mpegurl" />
                <data android:scheme="http" android:mimeType="application/xspf+xml" />
                <data android:scheme="https" android:mimeType="application/xspf+xml" />
                <data android:scheme="content" android:mimeType="application/xspf+xml" />
                <data android:scheme="file" android:mimeType="application/xspf+xml" />
                <data android:scheme="http" android:mimeType="audio/mpeg" />
                <data android:scheme="https" android:mimeType="audio/mpeg" />
                <data android:scheme="http" android:mimeType="audio/aac" />
                <data android:scheme="https" android:mimeType="audio/aac" />
                <data android:scheme="http" android:mimeType="audio/aacp" />
                <data android:scheme="https" android:mimeType="audio/aacp" />
                <data android:scheme="http" android:mimeType="audio/ogg" />
                <data android:scheme="https" android:mimeType="audio/ogg" />
                <data android:scheme="http" android:mimeType="audio/opus" />
                <data android:scheme="https" android:mimeType="audio/opus" />
                <data android:scheme="http" android:mimeType="audio/flac" />
                <data android:scheme="https" android:mimeType="audio/flac" />
            </intent-filter>
            <!-- SHOUTcast / Icecast: links ending in .pls / .m3u / .xspf. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.pls" />
                <data android:pathPattern=".*\\..*\\.pls" />
                <data android:pathPattern=".*\\..*\\..*\\.pls" />
                <data android:pathPattern=".*\\.PLS" />
                <data android:pathPattern=".*\\..*\\.PLS" />
                <data android:pathPattern=".*\\..*\\..*\\.PLS" />
                <data android:pathPattern=".*\\.m3u" />
                <data android:pathPattern=".*\\..*\\.m3u" />
                <data android:pathPattern=".*\\..*\\..*\\.m3u" />
                <data android:pathPattern=".*\\.M3U" />
                <data android:pathPattern=".*\\..*\\.M3U" />
                <data android:pathPattern=".*\\..*\\..*\\.M3U" />
                <data android:pathPattern=".*\\.xspf" />
                <data android:pathPattern=".*\\..*\\.xspf" />
                <data android:pathPattern=".*\\..*\\..*\\.xspf" />
            </intent-filter>
            <!-- SHOUTcast icy:// links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="icy" />
            </intent-filter>
        </activity>

        <!-- Target of notification / lock-screen taps: does nothing while the phone is locked. -->
        <activity
            android:name=".OpenOriginActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".player.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <activity
            android:name=".RestartActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".alarm.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="app.vlcinterface.alarm"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.VlcInterface" />
        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name=".alarm.ClockDream"
            android:exported="true"
            android:label="vlc interface clock"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".sources.RgScanService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
